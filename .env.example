# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/fipconnect
# Test suite only; it wipes this database
TEST_DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/fipconnect_test

# Sites
FIP_ADMIN_HOST=admin.yoursite.com
FIP_CLIENT_URL=https://yoursite.com
# Allow creating the first admin account; set back to false afterwards
FIP_ALLOW_SETUP=false
# Clients must request event dates at least this many days ahead
FIP_MIN_LEAD_DAYS=7

# Email (SMTP)
FIP_SMTP_HOST=smtp.gmail.com
FIP_SMTP_PORT=587
FIP_SMTP_USERNAME=your-sending-address@example.com
FIP_SMTP_PASSWORD=your-email-app-password
FIP_SMTP_FROM=your-sending-address@example.com
FIP_SMTP_USE_SSL=false

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
